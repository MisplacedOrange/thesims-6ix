{
  "name": "the-sims-6ix-environment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run data:interactables",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run data:interactables",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "npm run data:interactables",
    "test": "node --test src/pedestrians.test.ts src/tree-placement.test.ts src/world.test.ts src/islands.test.ts src/interactables.test.ts",
    "data:interactables": "node scripts/prepare_interactables.mjs",
    "data:prepare": "python scripts/prepare_toronto.py",
    "data:islands": "python scripts/prepare_islands.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
