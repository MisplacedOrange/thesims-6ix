# Copy this file to .env and enter your key locally. Never commit actual credentials.
OPENAI_API_KEY=

# Choose a model your OpenAI project can access with Responses structured outputs.
OPENAI_MODEL=

# Opt in only when ready to send proposal/evidence context and incur API charges.
COUNCIL_OPENAI_ENABLED=false
COUNCIL_OPENAI_TIMEOUT_SECONDS=60
COUNCIL_OPENAI_MAX_OUTPUT_TOKENS=3000
