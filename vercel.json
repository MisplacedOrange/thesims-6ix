{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "sim.council:app",
      "includeFiles": [
        "apps/web/public/data/toronto.json",
        "sim/core/data/catalog.json",
        "sim/data/snapshots/toronto-downtown-sites-v3.json"
      ]
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
